PORT=5000
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_MS=30000
ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
ASSISTANT_RATE_LIMIT_MAX=10

# Optional: enables semantic retrieval using MongoDB Atlas Vector Search.
MONGODB_URI=
ATLAS_VECTOR_SEARCH_ENABLED=false
MONGODB_DB_NAME=samvidhan_ai
MONGODB_COLLECTION=constitutional_chunks
MONGODB_SERVER_TIMEOUT_MS=5000
ATLAS_VECTOR_INDEX=constitution_vector_index

# Gemini embedding configuration; 768 dimensions must match the Atlas index JSON.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_CONCURRENCY=2
# Translation requests can take longer for long constitutional passages.
AI_REQUEST_TIMEOUT_MS=90000
# Optional second model ID to use if the primary model is temporarily overloaded.
# GEMINI_FALLBACK_MODEL=your-supported-gemini-model-id
